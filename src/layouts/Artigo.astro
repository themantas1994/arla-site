---
import Base from './Base.astro';
import MigalhasPao from '@components/MigalhasPao.astro';
import IndiceConteudos from '@components/IndiceConteudos.astro';
import Partilhar from '@components/Partilhar.astro';
import Aviso from '@components/Aviso.astro';
import Icone from '@components/Icone.astro';
import CartaoArtigo from '@components/CartaoArtigo.astro';
import type { MarkdownHeading } from 'astro';
import { dataExtenso, tempoLeitura } from '@lib/sitio';

export interface Props {
  titulo: string;
  resumo: string;
  data: Date;
  atualizado?: Date;
  autor?: string;
  indicativo?: string;
  categoria?: string;
  etiquetas?: string[];
  imagem?: string;
  imagemAlt?: string;
  historico?: boolean;
  notaHistorica?: string;
  titulos?: MarkdownHeading[];
  mostrarIndice?: boolean;
  corpoTexto: string;
  migalhas: { rotulo: string; href?: string }[];
  /** Ligações de navegação sequencial. */
  anterior?: { href: string; titulo: string };
  seguinte?: { href: string; titulo: string };
  relacionados?: {
    href: string; titulo: string; resumo: string; data: Date;
    categoria?: string; imagem?: string;
  }[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Bloco de informação do evento, colocado antes do corpo. */
  tipoArtigo?: 'noticia' | 'tecnica' | 'evento';
}
const {
  titulo, resumo, data, atualizado, autor, indicativo, categoria, etiquetas = [],
  imagem, imagemAlt, historico = false, notaHistorica, titulos = [], mostrarIndice = false,
  corpoTexto, migalhas, anterior, seguinte, relacionados = [], jsonLd, tipoArtigo = 'noticia',
} = Astro.props;

const minutos = tempoLeitura(corpoTexto);
const urlAbs = new URL(Astro.url.pathname, Astro.site).href;
const comIndice = mostrarIndice && titulos.filter((t) => t.depth === 2 || t.depth === 3).length >= 3;
---
<Base
  titulo={titulo}
  descricao={resumo}
  imagem={imagem}
  tipo="article"
  jsonLd={jsonLd}
  publicado={data}
  modificado={atualizado}
>
  <article class={`artigo ${comIndice ? '' : 'artigo--centrado'}`}>
    <header class="artigo__cabecalho">
      <div class="envolvente artigo__cabecalho-interior">
        <MigalhasPao itens={migalhas} />

        <div class="artigo__etiquetas">
          {categoria && <span class="etiqueta etiqueta--accent">{categoria}</span>}
          {historico && <span class="etiqueta etiqueta--arquivo">Conteúdo de arquivo</span>}
        </div>

        <h1>{titulo}</h1>
        <p class="artigo__resumo">{resumo}</p>

        <div class="artigo__meta">
          <span>
            <Icone nome="calendario" />
            <time datetime={data.toISOString()}>{dataExtenso(data)}</time>
          </span>
          {atualizado && (
            <span>
              <Icone nome="relogio" />
              Atualizado a <time datetime={atualizado.toISOString()}>{dataExtenso(atualizado)}</time>
            </span>
          )}
          {(autor || indicativo) && (
            <span>
              <Icone nome="pessoas" />
              {autor}{autor && indicativo ? ' · ' : ''}
              {indicativo && <span class="mono">{indicativo}</span>}
            </span>
          )}
          <span><Icone nome="livro" /> {minutos} min de leitura</span>
        </div>
      </div>
    </header>

    {imagem && (
      <div class="envolvente artigo__imagem">
        <img src={imagem} alt={imagemAlt ?? ''} width="1200" height="675" fetchpriority="high" decoding="async" />
      </div>
    )}

    <div class={`envolvente artigo__grelha ${comIndice ? 'artigo__grelha--com-indice' : ''}`}>
      {comIndice && (
        <aside class="artigo__lateral nao-imprimir">
          <IndiceConteudos titulos={titulos} />
        </aside>
      )}

      <div class="artigo__conteudo">
        {historico && (
          <Aviso tipo="historico" titulo="Este conteúdo é histórico.">
            <p>
              {notaHistorica ??
                `Publicado em ${dataExtenso(data)} e mantido no arquivo da ARLA como registo. A informação pode já não estar atualizada.`}
            </p>
          </Aviso>
        )}

        <slot name="antes-do-corpo" />

        <div class="prosa">
          <slot />
        </div>

        {etiquetas.length > 0 && (
          <div class="artigo__tags">
            <span class="artigo__tags-rotulo">Etiquetas</span>
            {etiquetas.map((t) => <span class="etiqueta">{t}</span>)}
          </div>
        )}

        <div class="artigo__acoes">
          <Partilhar titulo={titulo} url={urlAbs} />
        </div>

        {(anterior || seguinte) && (
          <nav class="artigo__sequencia" aria-label="Navegação entre artigos">
            {anterior ? (
              <a href={anterior.href} rel="prev">
                <span class="artigo__sequencia-rotulo"><Icone nome="seta" class="rodar" /> Anterior</span>
                <strong>{anterior.titulo}</strong>
              </a>
            ) : <span></span>}
            {seguinte && (
              <a href={seguinte.href} rel="next" class="alinhar-fim">
                <span class="artigo__sequencia-rotulo">Seguinte <Icone nome="seta" /></span>
                <strong>{seguinte.titulo}</strong>
              </a>
            )}
          </nav>
        )}
      </div>
    </div>

    {relacionados.length > 0 && (
      <section class="seccao seccao--alt nao-imprimir">
        <div class="envolvente">
          <div class="cabecalho-seccao">
            <div>
              <p class="sobretitulo">Continuar a ler</p>
              <h2>Conteúdos relacionados</h2>
            </div>
          </div>
          <div class="grelha grelha--auto">
            {relacionados.map((r) => (
              <CartaoArtigo
                href={r.href}
                titulo={r.titulo}
                resumo={r.resumo}
                data={r.data}
                categoria={r.categoria}
                imagem={r.imagem}
              />
            ))}
          </div>
        </div>
      </section>
    )}
  </article>
</Base>

<style>
  .artigo__cabecalho {
    background: var(--fundo-2);
    border-bottom: 1px solid var(--borda);
  }
  /* Artigos sem índice lateral ficam numa coluna centrada: encostados à
     esquerda num ecrã largo, deixavam metade da página vazia. */
  .artigo__cabecalho-interior { padding-block: var(--e-6) var(--e-7); max-width: 56rem; }
  .artigo--centrado .artigo__cabecalho-interior { margin-inline: auto; }
  .artigo__etiquetas { display: flex; flex-wrap: wrap; gap: var(--e-2); margin-top: var(--e-4); }
  .etiqueta--arquivo { color: var(--alerta); border-color: color-mix(in srgb, var(--alerta) 40%, transparent); }
  .artigo__cabecalho h1 { margin-top: var(--e-3); font-size: var(--t-3xl); }
  .artigo__resumo { margin-top: var(--e-4); font-size: var(--t-lg); color: var(--texto-suave); max-width: 62ch; }
  .artigo__meta {
    display: flex; flex-wrap: wrap; gap: var(--e-2) var(--e-5);
    margin-top: var(--e-5); padding-top: var(--e-4);
    border-top: 1px solid var(--borda);
    font-size: var(--t-sm); color: var(--texto-fraco);
  }
  .artigo__meta > span { display: inline-flex; align-items: center; gap: 0.4rem; }
  .artigo__meta :global(svg) { width: 1rem; height: 1rem; color: var(--accent); }

  .artigo__imagem { margin-top: calc(var(--e-6) * -1); position: relative; z-index: 1; }
  .artigo--centrado .artigo__imagem { max-width: 56rem; margin-inline: auto; }
  .artigo__imagem img {
    width: 100%; max-height: 32rem; object-fit: cover;
    border-radius: var(--raio-lg); border: 1px solid var(--borda);
    box-shadow: var(--sombra-alta);
  }

  .artigo__grelha { padding-block: var(--e-7); display: grid; gap: var(--e-6); }
  .artigo--centrado .artigo__grelha { max-width: 56rem; margin-inline: auto; }
  @media (min-width: 1100px) {
    .artigo__grelha--com-indice { grid-template-columns: 17rem minmax(0, 1fr); gap: var(--e-7); }
    .artigo__lateral { order: -1; }
  }
  .artigo__conteudo { min-width: 0; display: flex; flex-direction: column; gap: var(--e-5); }
  .artigo__conteudo :global(.prosa) { max-width: none; }

  .artigo__tags {
    display: flex; flex-wrap: wrap; align-items: center; gap: var(--e-2);
    padding-top: var(--e-5); border-top: 1px solid var(--borda);
  }
  .artigo__tags-rotulo {
    font-size: var(--t-xs); font-weight: 700; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--texto-fraco); margin-right: 0.2rem;
  }

  .artigo__sequencia {
    display: grid; gap: var(--e-3); margin-top: var(--e-4);
    padding-top: var(--e-5); border-top: 1px solid var(--borda);
  }
  @media (min-width: 640px) { .artigo__sequencia { grid-template-columns: 1fr 1fr; } }
  .artigo__sequencia a {
    display: flex; flex-direction: column; gap: 0.35rem;
    padding: var(--e-4); border: 1px solid var(--borda); border-radius: var(--raio-lg);
    text-decoration: none; color: var(--texto); background: var(--superficie);
  }
  .artigo__sequencia a:hover { border-color: var(--accent); }
  .artigo__sequencia a.alinhar-fim { text-align: right; align-items: end; }
  .artigo__sequencia-rotulo {
    display: inline-flex; align-items: center; gap: 0.35rem;
    font-size: var(--t-xs); font-weight: 700; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--accent);
  }
  .artigo__sequencia-rotulo :global(svg) { width: 0.9rem; height: 0.9rem; }
  .artigo__sequencia-rotulo :global(.rodar) { transform: rotate(180deg); }
  .artigo__sequencia strong { font-size: var(--t-sm); font-weight: 600; line-height: 1.4; }
</style>
