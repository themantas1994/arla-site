---
import Base from './Base.astro';
import MigalhasPao from '@components/MigalhasPao.astro';
import FundoEspectro from '@components/FundoEspectro.astro';

export interface Props {
  titulo: string;
  /** Título mostrado no <h1>, quando diferente do título da página. */
  cabecalho?: string;
  descricao: string;
  sobretitulo?: string;
  migalhas: { rotulo: string; href?: string }[];
  imagem?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  semIndexacao?: boolean;
  /** Largura do conteúdo: 'normal' (1200px) ou 'estreito' (texto longo). */
  largura?: 'normal' | 'estreito';
}
const {
  titulo, cabecalho, descricao, sobretitulo, migalhas,
  imagem, jsonLd, semIndexacao, largura = 'normal',
} = Astro.props;
---
<Base titulo={titulo} descricao={descricao} imagem={imagem} jsonLd={jsonLd} semIndexacao={semIndexacao}>
  <div class="pagina-topo">
    <FundoEspectro variante="faixa" />
    <div class="envolvente pagina-topo__interior">
      <MigalhasPao itens={migalhas} />
      {sobretitulo && <p class="sobretitulo">{sobretitulo}</p>}
      <h1>{cabecalho ?? titulo}</h1>
      <p class="pagina-topo__descricao">{descricao}</p>
      <slot name="cabecalho-extra" />
    </div>
  </div>

  <div class={`envolvente pagina-corpo pagina-corpo--${largura}`}>
    <slot />
  </div>
</Base>

<style>
  .pagina-topo {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-bottom: 1px solid var(--borda);
    background: var(--fundo-2);
  }
  .pagina-topo__interior {
    position: relative;
    z-index: 1;
    padding-block: var(--e-6) var(--e-7);
    max-width: 58rem;
  }
  .pagina-topo h1 { margin-top: var(--e-3); }
  .pagina-topo .sobretitulo { margin-top: var(--e-4); margin-bottom: 0; }
  .pagina-topo__descricao {
    margin-top: var(--e-4);
    font-size: var(--t-lg);
    color: var(--texto-suave);
    max-width: 62ch;
  }
  .pagina-corpo { padding-block: var(--e-8); }
  .pagina-corpo--estreito { max-width: 56rem; margin-inline: auto; }
</style>
