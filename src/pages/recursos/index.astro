---
import Pagina from '@layouts/Pagina.astro';
import Icone from '@components/Icone.astro';
import { getCollection } from 'astro:content';
import { tecnica } from '@lib/conteudo';

const documentos = await getCollection('documentos');
const ligacoes = await getCollection('ligacoes');
const faq = await getCollection('faq');
const artigos = await tecnica();

const blocos = [
  { rotulo: 'Artigos técnicos', href: '/tecnica/', icone: 'ferramenta', n: artigos.length,
    texto: 'Satélites, micro-ondas, modos digitais e experimentação, por associados da ARLA.' },
  { rotulo: 'Documentos', href: '/recursos/documentos/', icone: 'documento', n: documentos.length,
    texto: 'Estatutos, regulamentos internos e formulários da associação.' },
  { rotulo: 'Ligações úteis', href: '/recursos/ligacoes/', icone: 'externo', n: ligacoes.length,
    texto: 'Sítios de referência para licenciamento, propagação e satélites.' },
  { rotulo: 'Perguntas frequentes', href: '/recursos/faq/', icone: 'info', n: faq.length,
    texto: 'Associar-se, quotas, utilização dos repetidores e formação.' },
  { rotulo: 'Arquivo', href: '/arquivo/', icone: 'livro', n: null,
    texto: 'Todo o conteúdo publicado, organizado por ano.' },
  { rotulo: 'Pesquisa', href: '/pesquisa/', icone: 'pesquisa', n: null,
    texto: 'Pesquisar em notícias, eventos, artigos, páginas e documentos.' },
];
---
<Pagina
  titulo="Recursos"
  descricao="Documentos da ARLA, artigos técnicos, ligações úteis e perguntas frequentes — tudo o que precisa de consultar num só sítio."
  sobretitulo="Biblioteca"
  migalhas={[{ rotulo: 'Recursos' }]}
>
  <ul class="grelha grelha--auto blocos">
    {blocos.map((b) => (
      <li class="cartao bloco">
        <Icone nome={b.icone as any} />
        <h2><a href={b.href}>{b.rotulo}</a></h2>
        <p>{b.texto}</p>
        {b.n !== null && <span class="bloco__contagem">{b.n} {b.n === 1 ? 'item' : 'itens'}</span>}
      </li>
    ))}
  </ul>
</Pagina>

<style>
  .blocos { list-style: none; padding: 0; }
  .bloco { padding: var(--e-5); gap: var(--e-2); }
  .bloco > :global(svg) { width: 1.9rem; height: 1.9rem; color: var(--accent); margin-bottom: var(--e-2); }
  .bloco h2 { font-size: var(--t-lg); }
  .bloco h2 a { color: inherit; text-decoration: none; }
  .bloco h2 a::after { content: ''; position: absolute; inset: 0; }
  .bloco h2 a:hover { color: var(--accent); }
  .bloco p { font-size: var(--t-sm); color: var(--texto-suave); }
  .bloco__contagem { margin-top: auto; font-size: var(--t-xs); color: var(--texto-fraco); font-variant-numeric: tabular-nums; }
</style>
